{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantmind.local/contracts/r01/data-contract-2.schema.json",
  "title": "R01 external report envelope (v2.1, frozen by R01P0-W1C3)",
  "description": "外部 agent → 平台结构化回报信封。字段命名一律 snake_case；来源标识统一 source_task；source_at/received_at 分开（received_at 由平台写入）。canonical contract_hash = 所引 contract_version 对应合同文件 UTF-8 字节的 sha256（历史版本保存在 contracts/ 与 rev1-backup/）。v2.1（attempt3）：fixture 条件改为显式提供才匹配（非 fixture 禁用 fixture- 前缀）；metrics.value=null 机器强制 null_reason；kind 条件必填对应载荷。",
  "type": "object",
  "required": [
    "schema_version", "project_key", "workstream", "case_id", "source_task",
    "source_run_id", "strategy_id", "contract_version", "contract_hash",
    "source_node", "source_revision", "event_id", "seq", "kind", "data",
    "timestamps", "execution_status", "evidence_stage"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 2 },
    "project_key": { "const": "r01", "description": "canonical 小写；展示名 R01 仅用于 UI" },
    "workstream": { "enum": ["P0", "A", "B1", "B2", "B3", "D", "N"] },
    "case_id": { "type": "string", "minLength": 1 },
    "source_task": { "type": "string", "minLength": 1, "description": "来源任务标识（幂等键第一级，统一命名，三份合同一致）" },
    "source_run_id": { "type": "string", "minLength": 1 },
    "strategy_id": { "type": "string", "minLength": 1, "description": "P0 工程样例必须以 fixture- 前缀命名且 fixture=true（见 allOf 条件）" },
    "contract_version": { "type": "string" },
    "contract_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_node": { "enum": ["mac", "cloud"] },
    "source_revision": { "type": "string" },
    "event_id": { "type": "string", "minLength": 1 },
    "seq": { "type": "integer", "minimum": 0, "description": "同一 source_run_id 内单调递增；乱序不倒退（report-api.md §4）" },
    "kind": {
      "enum": ["progress", "data-check-report", "artifact", "metrics", "gap-report", "risk-confirm-request", "news-coverage", "state-change"],
      "description": "事件类别；各 kind 条件必填对应载荷字段（allOf），state-change 仅依赖顶层 execution_status"
    },
    "data": {
      "type": "object",
      "required": ["input_package_id", "data_as_of"],
      "additionalProperties": false,
      "properties": {
        "input_package_id": { "type": "string", "description": "固定输入包 package_id；P0 开发事件填 'none'" },
        "source_release_id": { "type": "string" },
        "data_as_of": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "timestamps": {
      "type": "object",
      "required": ["source_at", "received_at"],
      "additionalProperties": false,
      "properties": {
        "source_at": { "type": "string", "format": "date-time", "description": "来源事件时间（aware UTC，带 Z）" },
        "received_at": { "type": "string", "format": "date-time", "description": "平台接收时间，由平台写入；客户端提交时可省略该键，存储态必填" }
      }
    },
    "execution_status": { "enum": ["planned", "running", "blocked", "failed", "completed", "stale"] },
    "evidence_stage": {
      "enum": ["proposal", "data-check", "development-compare", "engineering-validation", "independent-verification", "forward-observation"],
      "description": "engineering-validation 专用于 P0 工程样例/工程验收，与真实研究证据阶段隔离"
    },
    "fixture": { "type": "boolean", "default": false, "description": "true=工程样例：strategy_id 须为 fixture-* 前缀；UI 显著标注，不进排行/真实曲线" },
    "progress_step": {
      "type": "object",
      "required": ["step_id", "title", "status"],
      "additionalProperties": false,
      "properties": {
        "step_id": { "type": "string" },
        "title": { "type": "string" },
        "status": { "enum": ["done", "in_progress", "blocked", "failed"] },
        "note": { "type": "string" }
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "result", "evidence_ref"],
        "additionalProperties": false,
        "properties": {
          "item": { "type": "string" },
          "result": { "enum": ["passed", "failed", "unknown"] },
          "evidence_ref": { "type": "string", "description": "artifact uri 或证据文件引用" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "kind", "sha256", "uri"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "kind": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "uri": { "type": "string", "description": "节点受控引用 node://<node>/<path> 或课题相对路径；禁止裸本地绝对路径" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "description": "结构化指标；未计算必须 value=null + null_reason，不得填 0（item 级 if/then 机器强制）",
      "items": {
        "type": "object",
        "required": ["metric", "value", "unit", "basis"],
        "additionalProperties": false,
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "null_reason": { "enum": ["not-computed", "no-data", "not-applicable", "pending-verification"] },
          "unit": { "type": "string" },
          "basis": { "type": "string", "description": "金额、时期、价格/费用口径、策略版本绑定" }
        },
        "if": { "required": ["value"], "properties": { "value": { "type": "null" } } },
        "then": { "required": ["null_reason"] }
      }
    },
    "news_coverage": {
      "type": "object",
      "required": ["decision_cutoff_at", "news_obtained_at"],
      "additionalProperties": false,
      "properties": {
        "decision_cutoff_at": { "type": "string", "format": "date-time", "description": "决策截止时间（D/N 必填）" },
        "news_obtained_at": { "type": "string", "format": "date-time", "description": "新闻实际取得时间（D/N 必填）" },
        "source_count": { "type": "integer", "minimum": 0 },
        "coverage_note": { "type": "string" }
      }
    },
    "risk_confirm": {
      "type": "object",
      "description": "kind=risk-confirm-request 的载荷：外部组请求用户确认风险暂停恢复（确认动作本身走 report-api.md §1 confirm-resume 路由）",
      "required": ["ledger_run_id", "risk_line", "risk_event_id", "action"],
      "additionalProperties": false,
      "properties": {
        "ledger_run_id": { "type": "string" },
        "risk_line": { "enum": ["loss_line", "drawdown_line"] },
        "risk_event_id": { "type": "string" },
        "action": { "enum": ["request-confirm"] },
        "nav": { "type": "number" }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gap_id", "desc"],
        "additionalProperties": false,
        "properties": {
          "gap_id": { "type": "string", "description": "引用 gaps.json 的 id（TG-*/DG-*/XG-*）" },
          "desc": { "type": "string" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["fixture"], "properties": { "fixture": { "const": true } } },
      "then": { "required": ["fixture"], "properties": { "strategy_id": { "pattern": "^fixture-" } } },
      "else": { "properties": { "strategy_id": { "not": { "pattern": "^fixture-" } } } }
    },
    { "if": { "properties": { "workstream": { "enum": ["D", "N"] } } }, "then": { "required": ["news_coverage"] } },
    { "if": { "properties": { "kind": { "const": "progress" } } }, "then": { "required": ["progress_step"] } },
    { "if": { "properties": { "kind": { "const": "data-check-report" } } }, "then": { "required": ["checks"] } },
    { "if": { "properties": { "kind": { "const": "artifact" } } }, "then": { "required": ["artifacts"] } },
    { "if": { "properties": { "kind": { "const": "metrics" } } }, "then": { "required": ["metrics"] } },
    { "if": { "properties": { "kind": { "const": "gap-report" } } }, "then": { "required": ["gaps"] } },
    { "if": { "properties": { "kind": { "const": "news-coverage" } } }, "then": { "required": ["news_coverage"] } },
    { "if": { "properties": { "kind": { "const": "risk-confirm-request" } } }, "then": { "required": ["risk_confirm"] } }
  ]
}
