<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.quantmind.local-primary</string>
  <key>RunAtLoad</key><true/>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>__PROJECT__/scripts/local-primary.sh</string><string>start</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>QM_PRIMARY_AUTOSTART</key><string>1</string>
  </dict>
  <key>StandardOutPath</key><string>__PROJECT__/logs/local-primary.out.log</string>
  <key>StandardErrorPath</key><string>__PROJECT__/logs/local-primary.err.log</string>
</dict>
</plist>
