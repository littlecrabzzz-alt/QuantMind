  "hypothesis": "固定行业分类、历史可得数据及成本后，RRG 相比简单行业动量能否改善风险调整收益或回撤；扩散度是否提供额外增量。",
  "protocol": {
    "purpose": "development_replication",
    "comparison_window": ["2022-09-01", "2026-08-31"],
    "window_note": "原项目已经报告过的时期，只作开发复现；最终独立测试窗口尚未确定。",
    "classification": "中信一级",
    "benchmark": "同分类行业日收益等权累乘",
    "exclude_industries": ["综合", "综合金融"],
    "parameters": {"ratio_lookback": 220, "momentum_lookback": 60, "smooth_window": 20},
    "warmup_sessions": 318,
    "min_price_observations": 319,
    "controls": ["行业等权", "220日相对动量Top6", "纯RRG", "纯扩散度", "扩散度Top6再筛领先或改善"],
    "selection": {"top_n": 6, "keep_quadrants": ["领先", "改善"], "refill_after_filter": false},
    "rebalance": "月末收盘生成信号，下一交易日开盘执行",
    "costs_one_way_bps": [10, 20, 30],
    "metrics": ["成本后收益", "相对动量超额", "Sharpe", "最大回撤", "换手", "现金比例", "分年表现", "集中度"],
    "rejection_rules": ["数据无法满足历史时点要求", "现实成本后相对简单动量无稳定增量", "优势集中于少数年份或单一参数"],
    "next_design_gate": "信号层数据通过后，先冻结行业名单、排序同分规则及持仓/现金权重；ETF阶段另冻结成交约束与集中度，不从最佳回测倒推方案。"
  },
