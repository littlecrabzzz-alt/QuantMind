{
  "purpose": "development_comparison",
  "hypothesis": "Within a universe selected using training-period liquidity, the eight-factor LightGBM Top20 improves net returns over 20-day momentum Top20 under identical execution and fees.",
  "market": "CN",
  "factor_source": "l1_factors",
  "features": ["mom_ret_1d", "mom_ret_5d", "mom_ret_20d", "mom_ma_gap_20", "vol_std_20", "vol_amp_20", "amt_ratio_5_20", "turn_1"],
  "split": {
    "train": ["2023-01-03", "2024-12-31"],
    "valid": ["2025-01-06", "2025-03-31"],
    "test": ["2025-04-07", "2025-06-30"]
  },
  "label": {"target_horizon_days": 1, "target_mode": "return"},
  "model": {
    "type": "lightgbm", "num_boost_round": 100, "early_stopping_rounds": 15,
    "params": {"learning_rate": 0.05, "num_leaves": 15, "max_depth": 4, "min_data_in_leaf": 200, "lambda_l2": 5, "num_threads": 4, "seed": 42, "deterministic": true, "force_col_wise": true}
  },
  "preprocessing": {"enabled": false},
  "universe": {"size": 100, "liquidity_days": 60, "min_observations": 40},
  "portfolio": {"topk": 20, "n_drop": 5, "risk_degree": 0.95, "initial_capital": 10000000, "single_factor": "mom_ret_20d", "benchmark": "SH000300"},
  "exchange": {"deal_price": "close", "limit_threshold": 0.095, "commission": 0.00025, "min_commission": 5, "stamp_duty": 0.0005, "transfer_fee": 0.00001, "min_transfer_fee": 0.01, "impact_cost_coefficient": 0.0005}
}
